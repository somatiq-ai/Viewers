# OHIF Docker Configuration for Apache Backend
# Rename this file to .env and modify as needed for your environment

# Build Configuration
NODE_ENV=production
APP_CONFIG=config/default.js

# Docker Compose Project Name
COMPOSE_PROJECT_NAME=ohif

# Output Directory (where Apache will serve from)
OHIF_DIST_DIR=./dist

# Optional: External DICOM Server Configuration
# Configure these in your Apache virtual host or application config
# DICOM_WEB_URL=http://your-dicom-server:8080/dicom-web/
